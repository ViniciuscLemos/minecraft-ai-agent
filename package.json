{
  "name": "minecraft-ai-agent",
  "version": "0.1.0",
  "description": "An AI agent that plays Minecraft on your own server: you ask in plain text, it plans and does it.",
  "scripts": {
    "server:setup": "node scripts/setup-server.ts",
    "server": "node scripts/start-server.ts",
    "bot": "node --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:scenario": "vitest run --config vitest.scenario.config.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
