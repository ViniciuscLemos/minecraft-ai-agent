# Minecraft server the bot joins (the local one from `npm run server` by default)
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21.1
BOT_NAME=Steve_AI

# Only players on this list can give orders in the chat (comma separated).
# Leave it empty to accept anyone, which is fine on your own local server.
BOT_OWNERS=

# Who turns "!do <request>" into steps: ai (an AI assistant's command-line program, run
# headless with the account you're logged into; no API key) or scripted (no AI, it only
# knows how to build).
PLANNER=ai
# Path of that command-line program, and optionally a lighter model to save usage
AI_CLI=
AI_MODEL=
