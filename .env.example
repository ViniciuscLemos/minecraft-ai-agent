# Minecraft server the bot joins (the local one from `npm run server` by default)
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.21.1
BOT_NAME=Steve_AI

# Only players on this list can give orders in the chat (comma separated).
# Leave it empty to accept anyone, which is fine on your own local server.
BOT_OWNERS=

# Who turns "!do <request>" into steps: claude (the Claude Code CLI, using the plan you
# are logged into with `claude`; no API key) or scripted (no AI, it only knows how to build).
PLANNER=claude
# Where claude.exe is, if it isn't found on its own (the desktop app's copy or the PATH)
CLAUDE_BIN=
